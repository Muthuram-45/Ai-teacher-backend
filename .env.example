# Node
NODE_ENV=production
PORT=8080

# Google Cloud (ADC is used on Cloud Run — no JSON key needed)
GOOGLE_CLOUD_PROJECT=your_google_cloud_project_id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_STORAGE_BUCKET=your_gcs_bucket_name

# Gemini API Key (only needed when GOOGLE_GENAI_USE_VERTEXAI is NOT true)
# GEMINI_API_KEY=your_gemini_api_key

# LiveKit
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# Video Generator Service URL (Cloud Run or local)
VIDEOGEN_API_URL=https://your-videogenerator-service.run.app

# Frontend CORS (comma-separated for multiple origins)
FRONTEND_URL=https://your-skymeet-frontend.vercel.app

# Email (for nodemailer, if used)
EMAIL_USER=
EMAIL_PASS=

# Teacher credentials (JSON string, optional — defaults used if not set)
# TEACHER_CREDENTIALS={"tutor@skymeet.com":{"password":"your_password"}}

# Optional: Local development only (not needed on Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
